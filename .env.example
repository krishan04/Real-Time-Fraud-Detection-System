# Kafka listeners
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=9092
KAFKA_HOST_PORT=29092

# Topics
TOPIC_TRANSACTIONS=transactions
TOPIC_ALERTS=fraud_alerts

# PostgreSQL
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
